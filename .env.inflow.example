# Copy to .env.inflow and fill in.
#
# This file carries the plugin's PLATFORM identity only — the values Infra hands
# out when the plugin is provisioned in a space.
#
# Redis credentials are deliberately NOT here. They are a settings profile: the
# platform stores what the plugin's set-up form asks for and ships it with every
# call as body.settings, so one running plugin can serve many Redis servers and
# rotating a password needs no redeploy.

PLUGIN_ID=aa-bbb-ccc-dddd
INFRA_CRED=LS0tLS1CRUdJTiBOQVRTIFVTRVIgSldULS0t...   # base64 of the .creds blob
INFRA_URL=localhost:4222

# Optional: read a different dotenv (default .env.inflow)
# INFLOW_ENV_FILE=.env.inflow.staging

# Optional: override the NATS request/reply deadline in seconds (default 5s in
# the SDK). The Redis actions raise it in code; this wins over that if set.
# Raise it above the longest blocking pop / stream read you let a flow ask for.
# REQ_TIMEOUT=130
